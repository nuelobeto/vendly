# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API Keys
#
#   cp .env.example .env.local
#
# This file is committed. Keep real values in .env.local, which is gitignored.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose to the browser — it is
# governed by Row Level Security. Never put a secret key (sb_secret_... or the
# legacy service_role JWT) in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used to build email confirmation redirect links.
# Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Email (Resend) — optional
#
# Used for app-sent emails such as store invitations. Without these, invites
# still work by copy-link; nothing else is affected.
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — that would inline the API key
# into the browser bundle.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Must be a verified sender on your Resend domain.
# Either "invites@yourdomain.com" or "Vendly <invites@yourdomain.com>".
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# NOTE: Supabase auth emails (signup confirmation, password reset) do NOT go
# through the variables above. Supabase sends those itself; the templates are
# edited in the Supabase dashboard.
#
# To deliver them via Resend, point Supabase's SMTP at Resend:
#   Authentication -> Emails -> SMTP Settings
#   Host smtp.resend.com   Port 465   User "resend"   Pass <your RESEND_API_KEY>
# That also removes Supabase's built-in limit of a few emails per hour.
# ---------------------------------------------------------------------------
