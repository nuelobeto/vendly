# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API Keys
#
#   cp .env.example .env.local
#
# This file is committed. Keep real values in .env.local, which is gitignored.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose to the browser — it is
# governed by Row Level Security. Never put a secret key (sb_secret_... or the
# legacy service_role JWT) in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used to build email confirmation redirect links.
# Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=
